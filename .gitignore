# Artefacts de compilation TypeScript émis à côté des sources.
# Un .js jumeau d'un .ts peut masquer la vraie source au moment du bundle :
# lib/progression.js, figé la veille, a servi en production pendant une
# semaine à la place de lib/progression.ts et cassé toutes les pages cabinet.
lib/**/*.js
data/**/*.js
components/**/*.js
**/*.js.map
